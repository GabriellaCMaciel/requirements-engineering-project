# Copie para .env (que NÃO é versionado) e preencha.

# Banco PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/jcresolve"

# Segredos do Auth.js (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# URL pública do site (usada nas imagens de compartilhamento, ex.: prévia no WhatsApp)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Administrador criado pelo seed (yarn prisma db seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
