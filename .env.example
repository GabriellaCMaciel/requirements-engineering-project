# =====================================================================
# Variáveis de ambiente da JC Resolve
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA faça commit do arquivo `.env` (ele contém segredos).
# =====================================================================

# Conexão com o banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://user:password@localhost:5432/jcresolve"

# Segredos de autenticação (Auth.js / NextAuth)
# Gere um valor aleatório seguro, por exemplo com:  openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# URL base da aplicação (opcional em desenvolvimento local)
# Em produção, defina a URL pública do site.
# NEXTAUTH_URL="http://localhost:3000"
